{
 "id": "mechanism",
 "kind": "mechanism",
 "title": "Why does automated flagging help? Sensitivity versus suspicion shift",
 "rationale": "Automated Flagging raised total accuracy by 4.4 points (95% CI [1.4, 7.3]) while the pooled effect was only +1.0 point and generic Flagging showed -1.0. This leaves open whether detector labels add information (better discrimination) or simply make people more suspicious of everything; the source reported fake and real accuracy separately but did not test the mechanism.",
 "contribution": "Separates informative-label (sensitivity) from label-presence (response bias) accounts of the automated flagging gain.",
 "limitations": [
  "Single session, online U.S. panel",
  "Small stimulus set so label reliability manipulations are coarse",
  "Self-reported reliance is a noisy mechanism measure"
 ],
 "design": {
  "title": "Label informativeness and AI-detection accuracy",
  "overview": "Respondents judge posts (half AI, half real) in a feed under one of three label conditions: no labels, accurate detector labels (correct 85% of the time), or uninformative labels (random with the same 50% flag rate). If gains come from information, only accurate labels help; if from raised suspicion, both labels shift judgments toward AI.",
  "hypothesis": "Accurate detector labels raise accuracy relative to control and random labels; random labels increase AI-judgments without increasing accuracy.",
  "primaryOutcome": "Share of posts judged correctly",
  "comparison": "Accurate labels vs random labels vs control; secondary: share of posts judged AI (bias), accuracy on real and AI posts separately",
  "population": "U.S. online panel adults, about 300 per arm",
  "conditions": [
   {
    "id": "control",
    "title": "No labels",
    "description": "Posts shown without any labels.",
    "nodeId": "arm_control"
   },
   {
    "id": "accurate",
    "title": "Accurate detector labels",
    "description": "Posts carry automated AI-detection labels that are correct 85% of the time.",
    "nodeId": "arm_accurate"
   },
   {
    "id": "random",
    "title": "Uninformative labels",
    "description": "Posts carry automated AI-detection labels assigned at random, flagging half of posts.",
    "nodeId": "arm_random"
