{
 "id": "mechanism",
 "kind": "mechanism",
 "title": "Does Automated Flagging improve discernment or just shift response bias?",
 "rationale": "Automated Flagging raised total accuracy by 4.4 points (95% CI [1.4, 7.3]), but total accuracy cannot separate real discernment from a bias toward answering 'AI'. Randomising label validity (accurate vs uninformative) lets a gain from accurate labels beyond the uninformative arm indicate discernment, while the share of 'AI' responses indicates bias.",
 "contribution": "Separates sensitivity from response bias in the automated-flagging effect by manipulating label informativeness.",
 "limitations": [
  "Single session, US online panel",
  "Labels are simulated, not from a real detector",
  "Effect on bias may differ by feed base rate"
 ],
 "design": {
  "title": "Label validity and AI-detection discernment",
  "overview": "Respondents judge 24 posts (12 AI-generated, 12 authentic). Arms: no label; accurate automated labels (about 80% correct); uninformative labels flagging a random 50% of posts. Sensitivity and specificity are computed.",
  "hypothesis": "Accurate labels raise both AI-post and real-post accuracy relative to control; uninformative labels shift the share of 'AI' responses without improving overall accuracy.",
  "primaryOutcome": "Discernment: hit rate on AI posts minus false-alarm rate on real posts (d-prime secondary).",
  "comparison": "Accurate labels vs uninformative labels vs no label.",
  "population": "US online panel adults, about 400 per arm.",
  "conditions": [
   {
    "id": "c_none",
    "title": "No label",
    "description": "Posts shown without labels.",
    "nodeId": "arm_none"
   },
   {
    "id": "c_valid",
    "title": "Accurate automated labels",
    "description": "Labels correct about 80% of the time.",
    "nodeId": "arm_valid"
   },
   {
    "id": "c_random",
    "title": "Uninformative labels",
    "description": "Labels unrelated to true status, flagging half of posts.",
    "nodeId": "arm_random"
   }
  ],
