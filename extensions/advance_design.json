{
 "id": "advance_design",
 "kind": "mechanism",
 "title": "Discernment vs response bias in AI labels",
 "rationale": "Automated Flagging raised total accuracy by 4.4 points (95% CI [1.4, 7.3]), and some arms raised the share of AI posts identified, but the source reports only share-correct scores. Without per-post responses to both AI and real posts, we cannot tell better discernment from a greater tendency to answer 'AI'. This design computes d' and criterion and adds confidence ratings and a label-accuracy arm.",
 "contribution": "Separates true sensitivity from response bias for automated AI labels, and tests whether a stated label error rate changes either.",
 "limitations": [
  "Single exposure and immediate measurement",
  "Stated error rate is a simulated label, not a real detector",
  "Online US panel only",
  "Sharing intention is self-reported"
 ],
 "design": {
  "title": "Discernment vs response bias in AI labels",
  "overview": "Respondents are randomised to control, Automated Flagging, or Automated Flagging with a stated 80% accuracy. Each judges 24 posts (12 AI-generated, 12 real), answering AI or Not AI with a confidence rating per post. d' and criterion are computed per respondent from hit and false-alarm rates.",
  "hypothesis": "Automated Flagging raises d' relative to control; any increase in AI responses (a more liberal criterion) is separate from sensitivity, and the stated error rate reduces reliance on labels.",
  "primaryOutcome": "d' computed from AI and real post responses (log-linear corrected), with criterion c as co-primary.",
  "comparison": "Each flagging arm vs control on d' and criterion; flagging vs flagging with error rate.",
  "population": "US adults from an online panel, about 400 per arm (1,200 total).",
  "conditions": [
   {
    "id": "c_control",
    "title": "Control",
    "description": "No labels on posts.",
    "nodeId": "arm_control"
   },
   {
    "id": "c_flag",
    "title": "Automated Flagging",
    "description": "Posts carry machine-learning AI-detection labels.",
    "nodeId": "arm_flag"
   },
   {
    "id": "c_flag_err",
    "title": "Automated Flagging with error rate",
    "description": "Same labels, plus a statement that labels are about 80% accurate.",
    "nodeId": "arm_flag_err"
   }
