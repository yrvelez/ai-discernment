{
 "id": "alternative",
 "kind": "alternative",
 "title": "Feedback-based practice versus the AI Literacy Guide for spotting AI media",
 "rationale": "In the source study, passive pre-feed materials mostly did not help: the pooled accuracy effect was +1.0 point (95% CI [-0.3, +2.4]), and the AI Literacy Guide's +4.7 points had a CI that barely excluded zero. Automated flagging (+4.4) worked but needs external infrastructure. Active practice with immediate correctness feedback could teach detection without labels on each post.",
 "contribution": "Tests whether learning by practice with feedback beats passive literacy materials for AI-media discernment.",
 "limitations": [
  "Immediate effects in one session only",
  "Online panel; practice items may resemble test items",
  "Feedback may shift response bias toward answering AI instead of improving sensitivity",
  "Sample size is a judgment call and effects may be small"
 ],
 "design": {
  "title": "Practice with feedback vs literacy guide vs control",
  "overview": "Respondents are randomised to control, a passive AI-literacy guide, or a 6-item practice task with correctness feedback. All then judge the same 8 posts and answer a confidence item.",
  "hypothesis": "Practice with feedback raises accuracy more than the passive guide, which in turn does not differ from control.",
  "primaryOutcome": "Share of 8 test posts correctly classified as AI-generated or authentic.",
  "comparison": "Practice-with-feedback vs guide vs control on test accuracy.",
  "population": "US adults from an online panel, about 300 per arm.",
  "conditions": [
   {
    "id": "c_control",
    "title": "Control",
    "description": "No intervention before the judgment task.",
    "nodeId": "arm_control"
   },
   {
    "id": "c_guide",
    "title": "Passive guide",
    "description": "Reads a short guide with examples of AI artifacts in images and video.",
    "nodeId": "arm_guide"
   },
   {
    "id": "c_practice",
    "title": "Practice with feedback",
    "description": "Classifies practice posts and sees whether each answer was correct, with a brief explanation.",
    "nodeId": "arm_practice"
   }
  ],
