{
 "id": "alternative",
 "kind": "alternative",
 "title": "Does a brief AI Literacy Guide or a mindfulness exercise change AI-media accuracy in an adequately powered replication?",
 "rationale": "In the source study the AI Literacy Guide (+4.7 points, CI barely above zero) and Mindfulness (-3.9 points) effects depended on IPW weighting, and arms had only 78 to 181 respondents. This design replicates both against a control with equal, larger arms and pre-specifies weighted and unweighted estimates.",
 "contribution": "Gives a well-powered, pre-specified replication of the two weight-dependent accuracy effects with weighted and unweighted estimates reported side by side.",
 "limitations": [
  "Single session, immediate effects only",
  "Online U.S. panel; quota matching is an imperfect benchmark for the correct weighting model",
  "Uses a different image set than the original 24 posts, so stimulus effects may differ"
 ],
 "design": {
  "title": "Replication of Guide and Mindfulness effects on AI-media discernment",
  "overview": "Respondents are randomised to control, a comprehensive AI Literacy Guide, or a short mindfulness exercise, then judge images as AI-generated or authentic and answer the source confidence item.",
  "hypothesis": "The Guide raises total accuracy and mindfulness lowers it relative to control, in both weighted and unweighted estimates.",
  "primaryOutcome": "Share of posts judged correctly (AI or authentic).",
  "comparison": "Guide vs control and Mindfulness vs control on total accuracy, reported unweighted and with IPW.",
  "population": "U.S. adults on an online panel with age, gender, race and education quotas; about 600 per arm.",
  "conditions": [
   {
    "id": "c_control",
    "title": "Control",
    "description": "No pre-task material.",
    "nodeId": "arm_control"
   },
   {
    "id": "c_guide",
    "title": "AI Literacy Guide",
    "description": "Guide with examples of AI artifacts in images and videos.",
    "nodeId": "arm_guide"
   },
   {
    "id": "c_mind",
    "title": "Mindfulness",
    "description": "Short mindfulness exercise.",
    "nodeId": "arm_mind"
   }
