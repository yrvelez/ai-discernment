{
 "id": "generalizability_conditional",
 "kind": "boundary",
 "title": "Label effect by label reliability and prior AI skill",
 "rationale": "Automated Flagging was the one robust gain (+4.4 points, 95% CI [1.4, 7.3], p=0.004; control n=181 of 2,030 analysed), but the labels' accuracy was not varied and no moderator such as AI familiarity was tested. This design tests whether the benefit holds when labels are 95% versus 70% accurate, across AI familiarity levels, and for images versus videos.",
 "contribution": "Maps the conditions (label reliability, AI familiarity, media type) under which automated AI labels improve discernment on both AI and real posts.",
 "limitations": [
  "Labels are simulated, not real detector outputs.",
  "Short post-exposure task on an online panel; 12 posts limit stimulus-level precision.",
  "Familiarity is self-reported and the strata are approximate.",
  "Power targets the main effect (MDE about 0.03), not the interactions."
 ],
 "design": {
  "title": "Automated labels: reliability, AI familiarity and media type",
  "overview": "Respondents report AI familiarity, then are randomised to no labels, labels that are 95% accurate, or labels that are 70% accurate. They judge 12 posts (6 images, 6 videos; half AI-generated, half real) and say whether each is AI-generated. Recruitment is stratified by AI familiarity.",
  "hypothesis": "Labels at 95% accuracy raise accuracy over control; labels at 70% accuracy raise it less or not at all, and may lower accuracy on posts the labels mislabel. The benefit is larger for low-familiarity respondents.",
  "primaryOutcome": "Share of posts judged correctly, reported separately for AI posts and real posts, and by image versus video.",
  "comparison": "Each label arm versus control; 95% versus 70% accuracy; interaction with ai_scale tercile and with media type.",
  "population": "US online panel adults, stratified into low, medium and high AI familiarity based on the ai_scale screener.",
  "conditions": [
   {
    "id": "c_control",
    "title": "No labels",
    "description": "Posts are shown without labels.",
    "nodeId": "arm_control"
   },
   {
    "id": "c_high",
    "title": "95% accurate labels",
    "description": "Automated labels on each post; participants are told the detector is correct about 95% of the time.",
    "nodeId": "arm_high"
   },
   {
    "id": "c_low",
    "title": "70% accurate labels",
    "description": "Automated labels on each post; participants are told the detector is correct about 70% of the time.",
    "nodeId": "arm_low"
