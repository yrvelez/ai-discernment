{
 "id": "generalizability_conditional",
 "kind": "boundary",
 "title": "Does the label effect hold for newer generators and low-trust respondents?",
 "rationale": "Automated Flagging raised accuracy by 4.4 points (95% CI [1.4, 7.3], p = 0.004) but the pooled effect across 11 arms was only +1.0 (SE 0.7), and stimuli were 2023-era with a US panel. Realism of current generators and baseline media trust may moderate the label effect, and durability was never measured.",
 "contribution": "Tests whether the Automated Flagging gain generalises across generator realism and baseline media trust and persists two weeks later.",
 "limitations": [
  "Interaction tests need large samples; the median split loses power.",
  "Current-generation stimuli must be sourced and verified by the research team.",
  "Re-contact attrition may bias the durability subsample.",
  "Single online panel; US only."
 ],
 "design": {
  "title": "Automated Flagging across generator realism and media trust",
  "overview": "Respondents report media trust and AI familiarity, then are randomised to Control or Automated Flagging. Each also sees a feed of posts randomly drawn from either a 2023-era or a current-generation synthetic set (mixed with authentic posts). They judge each post AI or real. A subsample is re-contacted two weeks later.",
  "hypothesis": "H1: Automated Flagging raises accuracy and d-prime relative to control. H2: The gain is smaller for current-generation stimuli. H3: The gain differs between low and high baseline media trust (median split, pre-registered).",
  "primaryOutcome": "Accuracy (share of posts judged correctly) and d-prime",
  "comparison": "Automated Flagging vs Control, crossed with stimulus set (2023 vs current) and median-split media trust; interactions are the focal tests.",
  "population": "US online panel adults, about 1,400 per stimulus set crossed design; quota sampled on age, gender and education.",
  "conditions": [
   {
    "id": "c_control",
    "title": "Control",
    "description": "Posts shown without labels.",
    "nodeId": "arm_control"
   },
   {
    "id": "c_flag",
    "title": "Automated Flagging",
    "description": "Posts carry machine-learning AI-detection labels.",
    "nodeId": "arm_flag"
   }
