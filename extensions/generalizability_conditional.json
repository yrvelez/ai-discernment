{
 "id": "generalizability_conditional",
 "kind": "boundary",
 "title": "Does the Automated Flagging gain depend on AI familiarity and feed realism?",
 "rationale": "Automated Flagging raised accuracy by 4.4 points (SE 1.5, p=0.004) in a stylised 24-post feed, but it was one of 44 uncorrected registered tests (8 significant) and the familiarity moderator was only exploratory. A stylised feed may overstate the effect, so this tests whether it holds across familiarity levels and in a realistic mixed feed.",
 "contribution": "Tests whether the Automated Flagging accuracy gain generalises across AI familiarity and to a more realistic feed.",
 "limitations": [
  "Familiarity is self-reported and may be imperfect",
  "Realistic feed content is fixed by the research team and may not match any real platform",
  "Online US panel only",
  "Interaction tests need larger samples than the main effect"
 ],
 "design": {
  "title": "Automated Flagging x feed realism, moderated by AI familiarity",
  "overview": "After consent and a pre-treatment AI-familiarity measure, respondents are randomised to one of four cells: control or Automated Flagging, crossed with a stylised feed (only AI and authentic target posts) or a realistic mixed feed (target posts plus non-target content and varied post quality). Respondents judge each target post as AI-generated or not, then answer confidence items. Recruitment is stratified on familiarity (low vs high).",
  "hypothesis": "Automated Flagging raises accuracy in both feeds; the gain is smaller in the realistic feed and does not differ materially between low and high AI familiarity.",
  "primaryOutcome": "Accuracy: share of target posts judged correctly, with AI-post and authentic-post detection reported separately.",
  "comparison": "Automated Flagging vs control within each feed type; feed x treatment and familiarity x treatment interactions.",
  "population": "US online panel adults, stratified on AI familiarity (low vs high), about 500 per cell.",
