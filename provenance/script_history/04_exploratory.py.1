"""
Exploratory analyses for the AI Discernment survey experiment.
Three pre-specified exploratory checks to interpret registered results.
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import os

# ── Setup ──────────────────────────────────────────────────────────────────────
os.makedirs('results', exist_ok=True)
os.makedirs('figures', exist_ok=True)

df = pd.read_csv('data/clean.csv')

arm_labels = {
    0: 'Control', 1: 'Flagging', 2: 'Provenance', 3: 'Automated Flagging',
    4: 'AI Accuracy Nudge', 5: 'Breathing Exercise', 6: 'Mindfulness',
    7: 'Inoculation', 8: 'AI Literacy Infographic',
    9: 'AI Literacy Infographic 2', 10: 'AI Literacy Guide', 11: 'AI Text Video'
}

ACCENT = '#2171b5'
GREY = '#666666'
INK = '#222222'

# ── Helper: extract arm coefficients ──────────────────────────────────────────
def extract_arm_coefs(model, n_arms=11):
    rows = []
    for arm in range(1, n_arms + 1):
        term = f'C(arm_code, Treatment(reference=0))[T.{arm}]'
        if term in model.params.index:
            ci = model.conf_int().loc[term]
            rows.append({
                'arm_code': arm,
                'arm_label': arm_labels[arm],
                'estimate': model.params[term],
                'std_error': model.bse[term],
                'p_value': model.pvalues[term],
                'conf_low': ci[0],
                'conf_high': ci[1],
            })
    return pd.DataFrame(rows)

# ═══════════════════════════════════════════════════════════════════════════════
# E1: AI familiarity (ai_scale) as moderator of AI-literacy-arm effects
# Rationale: The three AI-literacy arms (8, 9, 10) show divergent effects on
# total_score; testing whether prior AI familiarity moderates these effects
# clarifies whether the interventions are most effective for less-familiar users.
# ═══════════════════════════════════════════════════════════════════════════════
df['ai_scale_c'] = df['ai_scale'] - df['ai_scale'].mean()

# Subset to control + the three AI-literacy arms for a focused interaction test
df_e1 = df[df['arm_code'].isin([0, 8, 9, 10])].copy()
formula_e1 = 'total_score ~ C(arm_code, Treatment(reference=0)) * ai_scale_c'
model_e1 = smf.ols(formula_e1, data=df_e1).fit(cov_type='HC2')

e1_rows = []
for arm in [8, 9, 10]:
    term = f'C(arm_code, Treatment(reference=0))[T.{arm}]:ai_scale_c'
    if term in model_e1.params.index:
        ci = model_e1.conf_int().loc[term]
        e1_rows.append({
            'arm_code': arm,
            'arm_label': arm_labels[arm],
            'estimate': model_e1.params[term],
            'std_error': model_e1.bse[term],
            'p_value': model_e1.pvalues[term],
            'conf_low': ci[0],
            'conf_high': ci[1],
            'n': len(df_e1),
        })
e1_df = pd.DataFrame(e1_rows)
e1_df.to_csv('results/E1_ai_scale_moderation.csv', index=False)

sig_e1 = e1_df[e1_df['p_value'] < 0.05]
if len(sig_e1) > 0:
    r = sig_e1.iloc[0]
    e1_summary = (f"E1: AI familiarity significantly moderates {len(sig_e1)}/3 AI-literacy-arm "
                  f"effects (e.g. {r['arm_label']}: β={r['estimate']:.3f}, p={r['p_value']:.3f})")
else:
    e1_summary = (f"E1: No significant AI-familiarity moderation of AI-literacy-arm effects "
                  f"(all p > 0.05; range p={e1_df['p_value'].min():.3f}–{e1_df['p_value'].max():.3f})")
print(e1_summary)

# Figure E1
fig, ax = plt.subplots(figsize=(6, 2.8))
cols = [ACCENT if p < 0.05 else GREY for p in e1_df['p_value']]
ax.hlines(e1_df['arm_code'], e1_df['conf_low'], e1_df['conf_high'],
          color=cols, linewidth=2.2, zorder=2)
ax.plot(e1_df['estimate'], e1_df['arm_code'], 'o', color=cols, markersize=7, zorder=3)
ax.axvline(0, color=INK, linewidth=0.7, linestyle='--', zorder=1)
ax.set_yticks(e1_df['arm_code'])
ax.set_yticklabels(e1_df['arm_label'], fontsize=9, color=INK)
ax.set_xlabel('Interaction: effect per +1 unit AI familiarity (95 % CI)', fontsize=9, color=INK)
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)
ax.spines['left'].set_visible(False)
ax.tick_params(left=False, labelbottom=True, labelcolor=INK)
ax.set_title('AI-familiarity moderation (AI-literacy arms vs. control)', fontsize=10, color=INK, pad=8)
plt.tight_layout()
plt.savefig('figures/E1_ai_scale_moderation.png', dpi=200, bbox_inches='tight', facecolor='white')
plt.close()

# ═══════════════════════════════════════════════════════════════════════════════
# E2: Robustness — exclude respondents who failed both attention checks
# Rationale: Excluding respondents with pk_score = 0 (failed both attention
# checks) tests whether the three registered-significant H1 arms remain
# significant under this stricter engagement criterion.
# ═══════════════════════════════════════════════════════════════════════════════
n_excl = int((df['pk_score'] == 0).sum())
df_e2 = df[df['pk_score'] > 0].copy()

formula_e2 = 'total_score ~ C(arm_code, Treatment(reference=0))'
model_e2 = smf.ols(formula_e2, data=df_e2).fit(cov_type='HC2')
e2_df = extract_arm_coefs(model_e2)
e2_df['n'] = len(df_e2)
e2_df.to_csv('results/E2_no_attention_fail.csv', index=False)

# Registered-significant arms for H1: 3 (p=.004), 6 (p=.032), 10 (p=.043)
reg_sig = [3, 6, 10]
still_sig = [a for a in reg_sig
             if e2_df.loc[e2_df['arm_code'] == a, 'p_value'].values[0] < 0.05]
e2_summary = (f"E2: After excluding {n_excl} attention-check failures (pk_score=0, "
              f"N={len(df_e2)}), {len(still_sig)}/3 registered-significant arms remain "
              f"significant (arms {still_sig if still_sig else 'none'})")
print(e2_summary)

# Figure E2
fig, ax = plt.subplots(figsize=(6, 5))
e2_s = e2_df.sort_values('estimate').reset_index(drop=True)
cols2 = [ACCENT if p < 0.05 else GREY for p in e2_s['p_value']]
ax.hlines(e2_s['arm_code'], e2_s['conf_low'], e2_s['conf_high'],
          color=cols2, linewidth=2.2, zorder=2)
ax.plot(e2_s['estimate'], e2_s['arm_code'], 'o', color=cols2, markersize=7, zorder=3)
ax.axvline(0, color=INK, linewidth=0.7, linestyle='--', zorder=1)
ax.set_yticks(e2_s['arm_code'])
ax.set_yticklabels(e2_s['arm_label'], fontsize=9, color=INK)
ax.set_xlabel('Effect on total_score vs. control (95 % CI)', fontsize=9, color=INK)
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)
ax.spines['left'].set_visible(False)
ax.tick_params(left=False, labelbottom=True, labelcolor=INK)
ax.set_title(f'Robustness: excluding {n_excl} attention-check failures', fontsize=10, color=INK, pad=8)
plt.tight_layout()
plt.savefig('figures/E2_no_attention_fail.png', dpi=200, bbox_inches='tight', facecolor='white')
plt.close()

# ═══════════════════════════════════════════════════════════════════════════════
# E3: Placebo — effect of interventions on attention-check score (pk_score)
# Rationale: If any intervention significantly changes performance on unrelated
# general-knowledge attention checks, this would indicate demand effects or
# general attention changes rather than specific AI-detection improvements.
# ═══════════════════════════════════════════════════════════════════════════════
formula_e3 = 'pk_score ~ C(arm_code, Treatment(reference=0))'
model_e3 = smf.ols(formula_e3, data=df).fit(cov_type='HC2')
e3_df = extract_arm_coefs(model_e3)
e3_df['n'] = len(df)
e3_df.to_csv('results/E3_placebo_pk_score.csv', index=False)

sig_e3 = e3_df[e3_df['p_value'] < 0.05]
if len(sig_e3) > 0:
    r = sig_e3.iloc[0]
    e3_summary = (f"E3: Placebo — {len(sig_e3)} arm(s) significantly affect attention-check "
                  f"score (e.g. {r['arm_label']}: β={r['estimate']:.3f}, p={r['p_value']:.3f}); "
                  f"possible demand effect")
else:
    e3_summary = (f"E3: Placebo — no arm significantly affects attention-check score "
                  f"(max |β|={e3_df['estimate'].abs().max():.3f}, min p={e3_df['p_value'].min():.3f}); "
                  f"supports specificity of treatment effects")
print(e3_summary)

print("All exploratory analyses complete.")
